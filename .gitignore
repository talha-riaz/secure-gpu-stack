# Audit output: scan results from real hosts (may include hostnames, IPs, package lists)
audit/results/
*.log
# ...except the curated evidence, which is meant to be read
!evidence/**/*.log

# Never commit keys or TOTP material
*.pem
*_key
*_key.pub
.google_authenticator
totp/

.DS_Store
__pycache__/

# Throwaway keys for local test VMs
tests/lima/.keys/
VERSION

# Editor settings
.idea/
.vscode/

# Reports regenerated locally with: python3 audit/report.py ... -o report
/report.md
/report.html
